# Copie para .env e preencha. O .env nunca vai para o Git.

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173
# mysql (padrão) ou json (lê backend/database/catalogo.json, sem precisar de MySQL)
DATA_SOURCE=mysql

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=galeria_paulo_canuto

# Imagens
# Pasta das versões web geradas por `npm run catalogar` (relativa à raiz do projeto)
MEDIA_DIR=media
# Endereço público das imagens. Local: /media. Produção: URL do bucket (ex.: Cloudflare R2)
MEDIA_BASE_URL=/media
